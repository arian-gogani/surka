# Postgres connection string. Leave empty to use the built-in local database
# (PGlite, stored in ./.pglite) for development.
DATABASE_URL=

# The direct, unpooled connection, used only to run migrations: a
# transaction-mode pooler is the wrong place for a long DDL transaction. The
# Neon integration sets this for you. Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# A Neon branch for preview deployments. Required on Vercel previews, because
# the Neon integration scopes one DATABASE_URL to both Preview and Production
# unless you create a branch, so a preview would otherwise read and write live
# swaps. The build migrates this branch, and the app refuses to start a preview
# without it. Unset locally.
PREVIEW_DATABASE_URL=

# Public URL of the app, used in emails and copied links.
APP_URL=http://localhost:3000

# Operator dashboard login.
ADMIN_PASSWORD=change-me

# Long random string used to sign the operator session cookie and the result
# banners on token pages. Changing it signs every session out, which is the
# only way to revoke one.
SESSION_SECRET=replace-with-a-long-random-string

# Protects the reminder cron endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-with-another-random-string

# Reminders are the product, and nothing is delivered without both of these.
# Until they are set, every due reminder stays due rather than being marked
# sent, and the daily run says so loudly instead of reporting success.
# EMAIL_FROM must be on a domain verified with Resend; an unverified one makes
# every send fail with a 403.
RESEND_API_KEY=
EMAIL_FROM=

# The address behind "Talk to us" on the landing page, and behind the "email
# us" links on swap and listing pages. With no value those links are not
# rendered at all, rather than pointing somewhere dead.
CONTACT_EMAIL=hello@example.com
