# Postgres connection string. Leave empty to use the built-in local database
# (PGlite, stored in ./.pglite) for development.
DATABASE_URL=

# Public URL of the app, used in emails and copied links.
APP_URL=http://localhost:3000

# Operator dashboard login.
ADMIN_PASSWORD=change-me
# Long random string used to sign the operator session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Protects the reminder cron endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-with-another-random-string

# Optional: send real reminder emails through Resend. Without it, emails are
# printed to the server log instead.
# Reminders are the product, and nothing is delivered without both of these.
# Until then every due reminder stays due and the cron answers 503 rather than
# pretending it sent anything. EMAIL_FROM must be on a domain verified with
# Resend; an unverified one makes every send fail with a 403.
# The direct, unpooled connection, used only to run migrations: a
# transaction-mode pooler is the wrong place for a long DDL transaction. The
# Neon integration sets this for you. Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

RESEND_API_KEY=
EMAIL_FROM=

# Where the "Run your first swap" button on the landing page sends people.
CONTACT_EMAIL=hello@example.com
