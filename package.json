{
  "name": "surka",
  "version": "0.1.0",
  "private": true,
  "description": "Surka runs partner swaps between software founders from yes to results.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check": "npm run typecheck && npm run test",
    "smoke": "node scripts/smoke.mjs",
    "setup:vercel": "bash scripts/setup-vercel-env.sh",
    "post": "tsx scripts/post.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
